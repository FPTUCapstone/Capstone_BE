# Copy to .env and adjust for your machine. Used by docker-compose only — never commit the
# real .env file. These defaults are for local development; regenerate the signing key and
# password before sharing or deploying anywhere beyond your own machine.

SA_PASSWORD=Passw0rd!Local
JWT_SIGNING_KEY=replace-with-a-long-random-secret
OPENROUTESERVICE__APIKEY=replace-with-your-ors-api-key
OPENROUTESERVICE__BASEURL=https://api.heigit.org/openrouteservice/

# TM-215 Gemini semantic POI ranking. Windows User Secrets are not available in Docker;
# provide the real API key only in the local, git-ignored .env file.
AiRanking__Enabled=true
AiRanking__Endpoint=https://generativelanguage.googleapis.com/v1/interactions
AiRanking__ApiKey=replace-with-your-gemini-api-key
AiRanking__ModelName=gemini-3.5-flash-lite

# TM-217 Gemini itinerary explanations. Keep disabled for safe offline local boots;
# when enabling it, provide the real API key only in the local, git-ignored .env file.
AiExplanation__Enabled=false
AiExplanation__Endpoint=https://generativelanguage.googleapis.com/v1/interactions
AiExplanation__ApiKey=
AiExplanation__ModelName=gemini-3.5-flash-lite
AiExplanation__TimeoutSeconds=10
AiExplanation__OverallTimeoutSeconds=20
AiExplanation__MaxAttempts=2
AiExplanation__RetryBaseDelayMilliseconds=500
AiExplanation__RateLimitPerMinute=4
AiExplanation__MaxConcurrency=2

# Service AI riêng (repo Capstone_AI) thay cho Gemini. Bật bằng: docker compose --profile ai up -d --build
# rồi bỏ comment các dòng dưới. Khóa dùng chung: python -c "import secrets; print(secrets.token_urlsafe(32))"
# TRIPMATE_AI_API_KEY=replace-with-a-long-random-secret
# AiRanking__Provider=TripMateAi
# AiRanking__Endpoint=http://ai:8000/v1/rank-pois
# AiRanking__ApiKey=<giá trị của TRIPMATE_AI_API_KEY>
# AiExplanation__Enabled=true
# AiExplanation__Provider=TripMateAi
# AiExplanation__Endpoint=http://ai:8000/v1/explain-itinerary
# AiExplanation__ApiKey=<giá trị của TRIPMATE_AI_API_KEY>
# EMBEDDING_MODEL=bge-m3
# Model local cho Compose: thư mục host chứa Modelfile + GGUF và đường dẫn Modelfile bên trong container.
# LLM_MODEL=tripmate-explainer
# TRIPMATE_MODEL_DIR=../Capstone_AI/models
# LLM_MODELFILE=/models/Modelfile
# Để dùng model public thay thế: LLM_MODEL=qwen3:1.7b và để trống LLM_MODELFILE.

# Shared Cloudinary account credentials (server-side signed operations only).
# Review-owned media uses a schema-version-stable namespace. Do not change its
# root without a compatible schema/data migration because SQL persists only the
# operation-owned opaque suffix used by upload, reconciliation and cleanup.
Cloudinary__CloudName=replace-with-your-cloud-name
Cloudinary__ApiKey=replace-with-your-api-key
Cloudinary__ApiSecret=replace-with-your-api-secret
Cloudinary__TourMediaFolderRoot=tripmate/tours
Cloudinary__ReviewMediaFolderRoot=tripmate/reviews
# Keep this equal to the folder containing legacy operator assets until they are migrated.
Cloudinary__OperatorDocumentsFolderRoot=tripmate/tours

# TM-207 delayed Cloudinary cleanup worker (enabled by default)
TourMediaCleanup__PollInterval=00:00:30
TourMediaCleanup__LeaseDuration=00:02:00
TourMediaCleanup__BatchSize=20

# Email / Password Reset
EMAIL_USERNAME=replace-with-smtp-username
EMAIL_PASSWORD=replace-with-smtp-app-password
EMAIL_FROM_EMAIL=noreply@example.com
PASSWORD_RESET_OTP_PEPPER=replace-with-a-long-random-secret

# Host-side port SQL Server is published on (container-internal port is always 1433). Not 1433
# by default because a native SQL Server install on the host commonly already owns 1433 — change
# this if 14330 is also taken. Match the host connection string supplied through User Secrets
# or ConnectionStrings__Default, not a tracked appsettings file.
DB_HOST_PORT=14330

# UC-14 Tomorrow.io hourly weather alerts. Keep the real key only in .env.
Tomorrow__Enabled=false
Tomorrow__ApiKey=

# Opt-in only for real provider smoke
TRIPMATE_CLOUDINARY_SMOKE=0

# Firebase Admin Configuration (Backend Secret - never commit real service account key)
Firebase__ProjectId=tripmate-82be3
#
# Firebase Admin service-account JSON — REQUIRED for Firebase ID-token authentication
# (register / verify-email / Google login). Without it the API boots but authentication
# via Firebase tokens fails closed (tokens are rejected).
#
# How to provide it:
#   1. Download your own service-account JSON from the Firebase console:
#      Project settings → Service accounts → Generate new private key.
#   2. Save it as ./secrets/tripmate-firebase-admin.json (relative to this repo root).
#      The secrets/ folder is git-ignored — the file is NEVER committed.
#   3. docker-compose.yml mounts ./secrets read-only into the API container and sets
#      GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/tripmate-firebase-admin.json.
#
# Alternative (no file): paste the JSON content inline instead — either as the
# FIREBASE_SERVICE_ACCOUNT_KEY_JSON environment variable or the
# Firebase__ServiceAccountKeyJson configuration key. Never commit either value.
#
# Local `dotnet run` (outside Docker): point GOOGLE_APPLICATION_CREDENTIALS at the JSON
# on your machine, e.g.:
# GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\tripmate-firebase-admin.json
# Public FE callback used in Firebase verification links (for example https://tripmate.example/verify-email)
EMAIL_VERIFICATION_CONTINUE_URL=

# UC-10 distributed generation rate limiter
REDIS_HOST_PORT=6379
REDIS_CONNECTION_STRING=redis:6379
# Optional: enables the real-Redis integration suite when tests run outside GitHub Actions.
TRIPMATE_REDIS_TEST_CONNECTION=localhost:6379

# REVIEW2: Tripadvisor (Terra) ratings and reviews - backend only. Keep disabled in development to save the shared quota.
Tripadvisor__Enabled=false
Tripadvisor__ApiKey=
Tripadvisor__CacheMinutes=720
Tripadvisor__DailyCallBudget=40

# REVIEW2: on-demand review translation (Gemini interactions API).
ReviewTranslation__Enabled=false
ReviewTranslation__ApiKey=
ReviewTranslation__ModelName=gemini-3.5-flash-lite

# REVIEW2: motorbike legs use the car network; duration x factor (0.5-1.5).
OPENROUTESERVICE__MOTORBIKEDURATIONFACTOR=0.9

# REVIEW2 D10: reorder for the time of day (sunrise beach, cool morning outdoors, shade at noon, sunset)
# only when the trip gets at most this many minutes longer.
TimeOfDay__Enabled=true
TimeOfDay__MaxExtraMinutes=15
