# syntax=docker/dockerfile:1.7
# Bakes TripMateDb (with tripmate_schema_v7.sql and all database migrations applied) into a SQL
# Server image, so a
# container started from it has the database ready immediately — no apply-schema.sh step needed.
# Build from the repo root using a BuildKit secret (never committed):
#   DOCKER_BUILDKIT=1 docker build --secret id=sa_password,env=SA_PASSWORD \
#     -f database/Dockerfile.seeded -t tripmate-db:v7 .
# The secret exists only while seeding; it is not persisted in an image layer, history, inspect
# metadata, or exported tar. Supply the password again at container runtime from local .env.
FROM mcr.microsoft.com/mssql/server:2022-latest

# seed-image.sh fails fast when the BuildKit secret is not supplied.
ENV ACCEPT_EULA=Y
ENV MSSQL_PID=Developer

COPY database/tripmate_schema_v7.sql /tmp/tripmate_schema_v7.sql
COPY database/migrations /tmp/migrations
COPY database/seed-image.sh /tmp/seed-image.sh

RUN --mount=type=secret,id=sa_password,uid=10001,gid=10001,mode=0400 \
    MSSQL_SA_PASSWORD="$(cat /run/secrets/sa_password)" /tmp/seed-image.sh
# Not deleting the temp files here: the base image's default (non-root) user can't remove files
# root-owned COPY created, and they're only a few KB — not worth fighting the permission for.
